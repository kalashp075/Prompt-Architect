# Public template only: never put a real secret in this file.
# Copy to .env locally, then replace placeholders with private values.
# Gemini API key from Google AI Studio.
GEMINI_API_KEY=your-google-ai-studio-api-key

# Current available Flash-tier model identifier from Google AI Studio.
GEMINI_MODEL=your-google-ai-studio-model-id

# Supabase Postgres connection string from Project Settings > Database.
DATABASE_URL=postgresql://your-supabase-db-user:your-supabase-db-password@your-supabase-db-host:5432/your-supabase-db-name

# Supabase JWT secret or JWKS URL, for the future auth phase.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase project URL used to derive the current JWKS endpoint.
SUPABASE_URL=your-supabase-project-url

# Optional explicit JWKS URL; defaults from SUPABASE_URL.
SUPABASE_JWKS_URL=your-supabase-jwks-url

# JWT issuer, normally the project URL plus /auth/v1.
SUPABASE_JWT_ISSUER=your-supabase-jwt-issuer

# Generate a long random value for Django's signing and security features.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated hostnames accepted by Django.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
