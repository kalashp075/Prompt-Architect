# Public template only: use placeholders here, never private credentials.
# Copy to .env locally, then replace placeholders with your values.
# Supabase project URL from Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase public anon key from Project Settings > API.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Django API origin used by the frontend.
VITE_API_BASE_URL=http://localhost:8000
